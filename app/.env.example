# Waitlist de la landing (NeonDB)
# Sin DATABASE_URL o sin conexión a internet, la app funciona 100% con fallback
# en memoria (no bloqueante, timeout de 1.5s y circuit breaker contra cuelgues).
DATABASE_URL=

# Agente conversacional FIBO — AWS Bedrock (primario)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0

# Sin credenciales configuradas, /api/agente responde con el fallback
# guionado (no bloqueante) — ver docs/07-construccion/decisiones-app-web.md.
